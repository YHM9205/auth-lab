<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Public Entries</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar.ejs') %>

        <h1>All Public Journal Entries</h1>

        <% if (entries.length===0) { %>
            <p>No public entries yet.</p>
            <% } %>

                <ul>
                    <% entries.forEach((entry)=> { %>
                        <li>
                            <h3>
                                <%= entry.title %>
                            </h3>
                            <p>
                                <%= entry.entryBody %>
                            </p>

                            <!-- أزرار التحكم تظهر فقط للمالك -->
                            <% if (user && entry.owner.equals(user._id)) { %>
                                <a href="/entries/<%= entry._id %>/edit">Edit</a>
                                <form action="/entries/<%= entry._id %>?_method=DELETE" method="POST"
                                    style="display: inline;">
                                    <button type="submit">Delete</button>
                                </form>
                                <% } %>
                        </li>
                        <% }) %>
                </ul>
</body>

</html>