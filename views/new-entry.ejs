<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Entry</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <%- include('./partials/navbar.ejs') %>

        <h1>Create a New Journal Entry</h1>

        <form action="/entries" method="POST">
            <label for="title">Title:</label>
            <input type="text" name="title" id="title" required maxlength="100">
            <br>
            <label for="entryBody">Body:</label>
            <textarea name="entryBody" id="entryBody" maxlength="350"></textarea>
            <br>
            <label for="isPublic">Make Public?</label>
            <input type="checkbox" name="isPublic" id="isPublic">
            <br>
            <br>
            <button type="submit">Create Entry</button>
        </form>
</body>

</html>